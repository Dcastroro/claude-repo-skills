{
  "name": "claude-repo-skills",
  "version": "0.1.0",
  "description": "Generate repository-aware Claude Code skills from real project structure and conventions.",
  "type": "module",
  "bin": {
    "claude-repo-skills": "bin/claude-repo-skills.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
